# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# SQLite (development)
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (production example)
# DATABASE_URL=postgresql://user:password@localhost:5432/restaurant_db

# Static and Media Files
STATIC_URL=/static/
MEDIA_URL=/media/

# Email Configuration (optional, for contact forms)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Restaurant Information
RESTAURANT_NAME=Your Restaurant Name
RESTAURANT_PHONE=+1-555-123-4567
RESTAURANT_EMAIL=info@yourrestaurant.com
RESTAURANT_ADDRESS=123 Main Street, City, State 12345

# Review Imports
# Google Places API — https://console.cloud.google.com/ → enable Places API
GOOGLE_PLACES_API_KEY=
# Find your Place ID at https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACE_ID=
# Yelp Fusion API — https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=
# Your Yelp business slug — last part of your Yelp URL (e.g. soho-pittsburgh-pittsburgh)
YELP_BUSINESS_ID=

# Security (production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
