# Copy to .env and fill in. Read by python-decouple (config/settings/*.py).
# Do NOT set EMAIL_BACKEND here — development.py uses the console backend,
# production.py uses SMTP.

# ── Django ───────────────────────────────────────────────────────────────────
# Required in production (no fallback). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Development only — production always runs with DEBUG off
DEBUG=True
# Comma-separated, e.g. soho.tazcomputer.com in production
ALLOWED_HOSTS=localhost,127.0.0.1
# Settings module. manage.py and wsgi.py default to production; on a dev
# machine set it to development (direnv's .envrc does this).
# DJANGO_SETTINGS_MODULE=config.settings.development

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=soho_db
DB_USER=soho_user
DB_PASSWORD=
DB_HOST=localhost
# The dev machine's PostgreSQL runs on 5433
DB_PORT=5432

# ── Email (production SMTP) ──────────────────────────────────────────────────
# EMAIL_HOST_USER is also the From address (mail servers reject a mismatch).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Server error (500) reports are emailed here in production. Blank = no emails.
ADMIN_EMAIL=

# ── Review imports (manage.py import_reviews) ────────────────────────────────
# Google Places API — https://console.cloud.google.com/ → enable Places API
GOOGLE_PLACES_API_KEY=
# Find your Place ID at https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACE_ID=
# Yelp Fusion API — https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=
# Your Yelp business slug — last part of your Yelp URL (e.g. soho-pittsburgh-pittsburgh)
YELP_BUSINESS_ID=
